# ── Database (Supabase Postgres) ─────────────────────────────────────────────
# Runtime: Supavisor pooler, transaction mode
DATABASE_URI=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
# Migrations: direct connection
DATABASE_URI_DIRECT=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
# Local alternative (docker compose up -d):
# DATABASE_URI=postgres://mba:mba@127.0.0.1:5432/mba
# DATABASE_URI_DIRECT=postgres://mba:mba@127.0.0.1:5432/mba

# ── Payload / site ───────────────────────────────────────────────────────────
PAYLOAD_SECRET=                       # long random string: openssl rand -hex 32
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ── Media storage (Supabase Storage, S3-compatible API) ─────────────────────
# Leave S3_BUCKET empty to store uploads on local disk (./media) in development.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
S3_REGION=eu-central-1
S3_BUCKET=media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional: public base URL of the bucket (derived from NEXT_PUBLIC_SUPABASE_URL + S3_BUCKET if empty)
S3_PUBLIC_URL=

# ── Email (contact form notifications) ───────────────────────────────────────
RESEND_API_KEY=                       # or use SMTP below
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
EMAIL_FROM=no-reply@your-domain.dz
EMAIL_FROM_NAME=MZAB Business Alliance
CONTACT_RECIPIENT=                    # overrides Site settings → Contact recipient

# ── Seed (pnpm seed) ─────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@mzab-alliance.dz
SEED_ADMIN_PASSWORD=
